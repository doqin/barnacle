# --- Discord ---
DISCORD_TOKEN=

# --- Groq (free tier only: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b) ---
GROQ_API_KEY=
MODEL_CHAT=openai/gpt-oss-120b
MODEL_UTILITY=openai/gpt-oss-20b
MODEL_FALLBACK=qwen/qwen3.8-27b

# --- Web search (optional; leave TAVILY_API_KEY empty to disable) ---
TAVILY_API_KEY=
SEARCH_MAX_PER_DAY=40
SEARCH_MAX_PER_USER_HOUR=4

# --- Supabase (service-role key; server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Behaviour ---
TZ=UTC
CHARACTER_PATH=character/character.md
# Un-pinged follow-ups: window after the bot's last message, and max in a row per channel
FOLLOWUP_WINDOW_SEC=180
MAX_UNPINGED_STREAK=4

# --- Autonomous outreach (DM only) ---
OUTREACH_ENABLED=true
OUTREACH_TICK_MIN=10
OUTREACH_START_HOUR=10
OUTREACH_END_HOUR=22
OUTREACH_MIN_GAP_HOURS=48
OUTREACH_QUIET_AFTER_CHAT_HOURS=12
OUTREACH_IGNORE_AFTER_HOURS=24
OUTREACH_MAX_PER_DAY=2
OUTREACH_MAX_STRIKES=3
# Chance per tick that an eligible user actually gets a message (adds natural jitter)
OUTREACH_FIRE_PROBABILITY=0.25

LOG_LEVEL=info
